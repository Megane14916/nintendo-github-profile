{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nintendo-github-presence",
  "main": ".wrangler/worker/worker.mjs",
  "no_bundle": true,
  "build": {
    "command": "node scripts/build-worker.mjs",
    "watch_dir": ["src", "fixtures", "scripts"]
  },
  "compatibility_date": "2026-11-24",
  "vars": {
    "PREVIEW_STATUS": "",
    "PRESENCE_SOURCE": "",
    "MAIN_NSA_ID": "",
    "NXAPI_AUTH_CLIENT_ID": ""
  },
  "kv_namespaces": [{ "binding": "PRESENCE_KV" }],
  "triggers": { "crons": ["*/2 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": false },
    // Subrequest traces can include credentials and the private Presence URL.
    "traces": { "enabled": false }
  }
}
